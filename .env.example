# Clave del panel de administración (obligatoria en producción)
ADMIN_PASSWORD=cambia-esta-clave
# Opcional: secreto para firmar la sesión (por defecto usa ADMIN_PASSWORD)
SESSION_SECRET=
# Base de datos. Local: archivo SQLite. Producción: URL de Turso (libsql://...)
DATABASE_URL=file:./data/rifamax.db
DATABASE_AUTH_TOKEN=
