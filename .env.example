# Clave del panel de administración (obligatoria en producción)
ADMIN_PASSWORD=cambia-esta-clave
# Opcional: secreto para firmar la sesión (por defecto usa ADMIN_PASSWORD)
SESSION_SECRET=

# MongoDB Atlas (capa gratis M0). Sin MONGODB_URI, en desarrollo se usa una base en memoria.
MONGODB_URI=
MONGODB_DB=rifamax

# Opcionales para pruebas (no las uses en la rifa real):
# RIFAMAX_DEMO=1          permite publicar sin MONGODB_URI, con datos en memoria que se borran
# RIFAMAX_DEMO_TICKETS=1  llena la base en memoria con jugadores de prueba
# DRAND_SIMULATE=1        simula drand sin internet (solo en desarrollo, en producción se ignora)
